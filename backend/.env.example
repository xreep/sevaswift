# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://sevaswift:sevaswift_dev@localhost:5432/sevaswift?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BROKERS=localhost:9092

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# File Uploads
UPLOAD_DIR=./uploads

# Google Maps API (optional, for ETA in Phase 2)
GOOGLE_MAPS_API_KEY=