# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://sevaswift:sevaswift_dev@localhost:5432/sevaswift?schema=public

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Dispatch tuning
DISPATCH_RADIUS_KM=15
OFFER_TIMEOUT_SECONDS=60
MAX_DISPATCH_ROUNDS=3
AVERAGE_SPEED_KMPH=25

# OpenRouteService key for road travel times (optional; straight-line estimate when absent)
ORS_API_KEY=